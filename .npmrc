registry=https://registry.npmjs.org/

# Example only — Misaki Studio OVERWRITES this file when it publishes the
# package, filling in the registry URL and token from your own git config.
# Nothing here is read at publish time; it documents the shape npm expects and
# lets a local `npm install` work if you point it at your own registry.
@misaki-studio:registry=https://registry.example.com/api/packages/your-user/npm/
//registry.example.com/api/packages/your-user/npm/:_authToken=${NPM_AUTH_TOKEN}
always-auth=true
